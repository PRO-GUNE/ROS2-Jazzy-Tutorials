<?xml version="1.0"?>
<robot>
  <!-- Chassis friction and color -->
  <gazebo reference="chassis">
    <mu1>0.25</mu1>
    <mu2>0.25</mu2>
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Wheel friction and color -->
  <gazebo reference="rr_wheel">
    <mu1>0.25</mu1>
    <mu2>0.25</mu2>
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rl_wheel">
    <mu1>0.25</mu1>
    <mu2>0.25</mu2>
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="fr_wheel">
    <mu1>0.25</mu1>
    <mu2>0.25</mu2>
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="fl_wheel">
    <mu1>0.25</mu1>
    <mu2>0.25</mu2>
    <material>Gazebo/Yellow</material>
  </gazebo>

  <!-- Sonar color -->
  <gazebo reference="sonar_sensor">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Differential drive plugin for four wheels -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
      <updateRate>100.0</updateRate>
      <robotNamespace></robotNamespace>
      <leftFrontJoint>fl_wheel_joint</leftFrontJoint>
      <rightFrontJoint>fr_wheel_joint</rightFrontJoint>
      <leftRearJoint>rl_wheel_joint</leftRearJoint>
      <rightRearJoint>rr_wheel_joint</rightRearJoint>
      <wheelSeparation>0.7</wheelSeparation>
      <wheelDiameter>0.3</wheelDiameter>
      <torque>1000</torque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>chassis</robotBaseFrame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- Camera sensor plugin -->
  <gazebo reference="cam_link">
    <material>Gazebo/Green</material>
    <sensor name="main_camera" type="camera">
        <pose> 0 0 0 0 0 0 </pose>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <camera>
            <horizontal_fov>1.089</horizontal_fov>
            <image>
                <format>R8G8B8</format>
                <width>640</width>
                <height>480</height>
            </image>
            <clip>
                <near>0.05</near>
                <far>8.0</far>
            </clip>
        </camera>
        <plugin name="main_camera_controller" filename="libgazebo_ros_camera.so">
            <frameName>cam_link_optical</frameName>
            <topicName>sensor/camera</topicName>
            <cameraName>main_camera</cameraName>
        </plugin>
    </sensor>
  </gazebo>

  <!-- Sonar plugin -->
  <gazebo reference="sonar_sensor">
    <sensor type="ray" name="ultrasonic">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>50</update_rate>
      <ray>
         <scan>
            <horizontal>
               <samples>10</samples>
               <resolution>1</resolution> 
               <min_angle>-0.01</min_angle>
               <max_angle>0.01</max_angle>
            </horizontal>
            <vertical>
               <samples>10</samples>
               <resolution>1</resolution> 
               <min_angle>-0.01</min_angle>
               <max_angle>0.01</max_angle> 
            </vertical>
         </scan>
         <range>
            <min>0.01</min>
            <max>5</max>
            <resolution>0.02</resolution>
         </range>
      </ray>
      <plugin name="ultrasonic_plugin" filename="libgazebo_ros_range.so">
        <topicName>sensor/sonar</topicName>
        <frameName>sonar_sensor</frameName>
        <alwaysOn>true</alwaysOn>
        <updateRate>50</updateRate>
        <gaussianNoise>0.005</gaussianNoise>
        <radiation>ULTRASOUND</radiation>
        <fov>1.0</fov>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Lidar plugin -->
  <gazebo reference="lidar_link">
    <sensor name="main_lidar" type="ray">
      <pose> 0 0 0 0 0 0 </pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
          <scan>
              <horizontal>
                  <samples>360</samples>
                  <min_angle>-3.14</min_angle>
                  <max_angle>3.14</max_angle>
              </horizontal>
          </scan>
          <range>
              <min>0.3</min>
              <max>12</max>
          </range>
      </ray>
      <plugin name="main_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
              <argument>~/out:=scan</argument>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frameName>lidar_link_frame</frameName>
          <topicName>sensor/lidar</topicName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
